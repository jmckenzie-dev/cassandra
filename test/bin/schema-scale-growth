# Which classes grow with the table count.
# Usage: test/bin/schema-scale-growth <run-dir>
#
# Reads <run-dir>/steps/t*/class-histogram.txt. Writes <run-dir>/growth.csv (top 30 classes by bytes per
# table), growth-all.csv and growth.md. Needs uv; it fetches pandas.
#
# Output: console and logs/<ts>-schema-scale-growth.log. Exit code: 0 on success, 1 when the run holds
# fewer than two usable histograms, 2 on a bad argument.

set -o pipefail

CASSANDRA_HOME="$(cd "$(dirname "$0")/../../" && pwd)"
export SCHEMA_SCALE_GROWTH_PWD="${SCHEMA_SCALE_GROWTH_PWD:-$PWD}"
cd "$CASSANDRA_HOME" || exit 1

if [ -z "${SCHEMA_SCALE_GROWTH_WRAPPED:-}" ]; then
    mkdir -p logs
    GROWTH_LOG="logs/$(date +%Y%m%d-%H%M%S)-schema-scale-growth.log"
    SCHEMA_SCALE_GROWTH_WRAPPED=1 bash "$CASSANDRA_HOME/test/bin/schema-scale-growth" "$@" 2>&1 | tee -i -a "$GROWTH_LOG"
    exit "${PIPESTATUS[0]}"
fi

RUN="${1:-}"
[ -n "$RUN" ] || { echo "usage: schema-scale-growth <run-dir>" >&2; exit 2; }
case "$RUN" in /*) ;; *) RUN="$SCHEMA_SCALE_GROWTH_PWD/$RUN" ;; esac
[ -d "$RUN" ] || { echo "schema-scale-growth: not a directory: $RUN" >&2; exit 2; }

exec uv run --no-project --quiet --with pandas python "$CASSANDRA_HOME/test/bin/schema-scale-growth.py" "$RUN"
