set -euo pipefail
project_root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$project_root"
mkdir -p logs
run_name="$(date +%Y%m%d-%H%M%S)-ai-test-memtable-lazy"
results_dir="logs/$run_name"
mkdir -p "$results_dir"
exec > >(tee "logs/$run_name.log") 2>&1
if [[ $# == 0 ]]; then
    test_classes=(
        org.apache.cassandra.db.memtable.TrieMemtableLazyTest
        org.apache.cassandra.db.memtable.TrieMemtableLazyPropertyTest
        org.apache.cassandra.distributed.test.TrieMemtableLazyRecoveryTest
    )
elif [[ $# == 1 && "$1" == --idle-admission ]]; then
    test_classes=(
        org.apache.cassandra.config.IdleMemtableConfigTest
        org.apache.cassandra.db.memtable.IdleFlushAdmissionBudgetTest
        org.apache.cassandra.db.memtable.IdleMemtableFlusherTest
        org.apache.cassandra.distributed.test.IdleMemtableFlushTest
        org.apache.cassandra.db.memtable.TrieMemtableRetirementTest
        org.apache.cassandra.db.memtable.TrieMemtableRetirementFailureTest
        org.apache.cassandra.db.virtual.SettingsTableTest
        org.apache.cassandra.db.compaction.unified.ControllerTest
        org.apache.cassandra.db.compaction.unified.ControllerHierarchyTest
    )
elif [[ $# == 1 && "$1" == --idle-admission-property ]]; then
    test_classes=(org.apache.cassandra.db.memtable.IdleFlushAdmissionBudgetPropertyTest)
elif [[ $# == 1 && "$1" == --ucs-hierarchy ]]; then
    test_classes=(
        org.apache.cassandra.db.compaction.unified.ControllerTest
        org.apache.cassandra.db.compaction.unified.ControllerHierarchyTest
        org.apache.cassandra.db.compaction.UnifiedCompactionStrategyTest
        org.apache.cassandra.db.compaction.unified.ShardedMultiWriterTest
        org.apache.cassandra.db.memtable.IdleMemtableFlusherTest
        org.apache.cassandra.distributed.test.IdleMemtableFlushTest
        org.apache.cassandra.distributed.test.MemtableResidencyConfigTest
        org.apache.cassandra.db.memtable.TrieMemtableRetirementTest
    )
elif [[ $# == 1 && "$1" == --ucs-hierarchy-property ]]; then
    test_classes=(org.apache.cassandra.db.compaction.unified.ControllerTest)
elif [[ $# == 1 && "$1" == --idle-flush ]]; then
    test_classes=(
        org.apache.cassandra.db.memtable.IdleMemtableFlusherTest
        org.apache.cassandra.distributed.test.IdleMemtableFlushTest
        org.apache.cassandra.db.memtable.TrieMemtableRetirementTest
        org.apache.cassandra.db.memtable.TrieMemtableRetirementFailureTest
        org.apache.cassandra.db.memtable.TrieMemtableLazyTest
        org.apache.cassandra.db.memtable.SplittablePartitionerTrieMemtableFlushSetTest
        org.apache.cassandra.db.memtable.NonSplittablePartitionerTrieMemtableFlushSetTest
        org.apache.cassandra.db.memtable.MemtableSizeHeapBuffersTest
        org.apache.cassandra.distributed.test.MemtableResidencyConfigTest
        org.apache.cassandra.distributed.test.TrieMemtableLazyRecoveryTest
        org.apache.cassandra.db.virtual.SettingsTableTest
    )
elif [[ $# == 1 && "$1" == --property ]]; then
    test_classes=(org.apache.cassandra.db.memtable.TrieMemtableLazyPropertyTest)
elif [[ $# == 1 && "$1" == --retirement ]]; then
    test_classes=(
        org.apache.cassandra.db.memtable.TrieMemtableRetirementTest
        org.apache.cassandra.db.memtable.TrieMemtableRetirementFailureTest
        org.apache.cassandra.db.memtable.TrieMemtableLazyTest
        org.apache.cassandra.db.memtable.SplittablePartitionerTrieMemtableFlushSetTest
        org.apache.cassandra.db.memtable.NonSplittablePartitionerTrieMemtableFlushSetTest
        org.apache.cassandra.db.memtable.MemtableSizeHeapBuffersTest
    )
elif [[ $# == 1 && "$1" == --histograms ]]; then
    test_classes=(
        org.apache.cassandra.utils.streamhist.StreamingTombstoneHistogramBuilderTest
        org.apache.cassandra.utils.streamhist.LazyTombstoneHistogramBuilderTest
        org.apache.cassandra.utils.streamhist.LazyTombstoneHistogramBuilderPropertyTest
        org.apache.cassandra.io.sstable.metadata.MetadataCollectorHistogramTest
        org.apache.cassandra.utils.streamhist.TombstoneHistogramAllocationTest
    )
elif [[ $# == 1 && "$1" == --histogram-property ]]; then
    test_classes=(org.apache.cassandra.utils.streamhist.LazyTombstoneHistogramBuilderPropertyTest)
elif [[ $# == 1 && "$1" == --reservoirs ]]; then
    test_classes=(
        org.apache.cassandra.metrics.AdaptiveCounterArrayTest
        org.apache.cassandra.metrics.AdaptiveCounterArrayPropertyTest
        org.apache.cassandra.metrics.CompactDecayingEstimatedHistogramReservoirTest
        org.apache.cassandra.metrics.CompactDecayingEstimatedHistogramReservoirPropertyTest
        org.apache.cassandra.metrics.CompactMetricsIntegrationTest
        org.apache.cassandra.metrics.CompactMetricsAccuracyTest
        org.apache.cassandra.metrics.DecayingEstimatedHistogramReservoirTest
        org.apache.cassandra.metrics.ThreadLocalHistogramTest
        org.apache.cassandra.metrics.CassandraMetricsRegistryTest
        org.apache.cassandra.metrics.LatencyMetricsTest
        org.apache.cassandra.metrics.JmxVirtualTableMetricsTest
    )
elif [[ $# == 1 && "$1" == --reservoir-property ]]; then
    test_classes=(
        org.apache.cassandra.metrics.AdaptiveCounterArrayPropertyTest
        org.apache.cassandra.metrics.CompactDecayingEstimatedHistogramReservoirPropertyTest
    )
elif [[ $# == 1 && "$1" == --meters ]]; then
    test_classes=(
        org.apache.cassandra.metrics.ThreadLocalMeterTest
        org.apache.cassandra.metrics.GeometricThreadLocalMeterTest
        org.apache.cassandra.metrics.GeometricThreadLocalMeterPropertyTest
    )
elif [[ $# == 1 && "$1" == --meter-property ]]; then
    test_classes=(org.apache.cassandra.metrics.GeometricThreadLocalMeterPropertyTest)
else
    echo 'Usage: ai-test-memtable-lazy [--idle-admission|--idle-admission-property|--ucs-hierarchy|--ucs-hierarchy-property|--idle-flush|--property|--retirement|--histograms|--histogram-property|--reservoirs|--reservoir-property|--meters|--meter-property]' >&2
    exit 2
fi
ant build-test
for test_class in "${test_classes[@]}"; do
    if .build/sh/ai-ci-test "$test_class" --reuse; then
        test_status=0
    else
        test_status=$?
    fi
    for target in test jvm-dtest; do
        if [[ -f "build/test/output/$target/TEST-$test_class.xml" ]]; then
            cp "build/test/output/$target/TEST-$test_class.xml" "$results_dir/"
        fi
    done
    if [[ -d build/test/logs ]]; then
        cp -a build/test/logs "$results_dir/$test_class"
    fi
    if [[ "$test_status" != 0 ]]; then
        exit "$test_status"
    fi
done
