set -euo pipefail
project_root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$project_root"
mkdir -p logs
batch="logs/$(date +%Y%m%d-%H%M%S)-java-allocation-${1:-invalid}"
mkdir -p "$batch"
exec > >(tee "$batch/batch-console.log") 2>&1
cp "$0" "$batch/"
if [[ $# != 1 || ( "$1" != histogram && "$1" != meter ) ]]; then
    echo 'Usage: ai-compare-java-allocation histogram|meter' >&2
    exit 2
fi
export MANY_TABLES_XMX=8g
export MANY_TABLES_CPUS=8
common=(--tables 100 --active-tables 10 --rows-per-table 4 --cycles 2 --rate 100
        --payload-bytes 128 --seed 1 --hold-ms 1000 --idle-ms 1000 --out "$batch")
if [[ "$1" == histogram ]]; then
    common+=(--scenario idle-reactivate --explicit-retirement)
    candidate=--lazy-tombstone-histograms
else
    common+=(--scenario never-written)
    candidate=--geometric-meter-arrays
fi
for mode in reference candidate candidate reference; do
    mode_args=()
    if [[ "$mode" == candidate ]]; then
        mode_args=("$candidate")
    fi
    .build/sh/ai-profile-memtable-residency "${common[@]}" "${mode_args[@]}" --no-profile
done
for mode in reference candidate; do
    mode_args=()
    if [[ "$1" == meter ]]; then
        mode_args+=(--heap-dumps)
    fi
    if [[ "$mode" == candidate ]]; then
        mode_args+=("$candidate")
    fi
    .build/sh/ai-profile-memtable-residency "${common[@]}" "${mode_args[@]}"
done
echo "Comparison artifacts: $batch"
