set -euo pipefail
project_root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$project_root"
mkdir -p logs
stamp="$(date +%Y%m%d-%H%M%S)"
exec > >(tee "logs/$stamp-heap-dominators.log") 2>&1
if [[ $# -lt 1 || $# -gt 2 || ! -f "$1" ]]; then
    echo 'Usage: bash .build/sh/ai-analyze-heap-dominators DUMP.hprof [MAT_QUERY]' >&2
    exit 2
fi
mat_directory="$project_root/tmp/mat/mat"
launchers=("$mat_directory"/plugins/org.eclipse.equinox.launcher_*.jar)
if [[ ${#launchers[@]} != 1 || ! -f "${launchers[0]}" ]]; then
    echo "Expected one existing Eclipse MAT launcher under $mat_directory" >&2
    exit 1
fi
query_limit="${MAT_QUERY_LIMIT:-1000}"
if [[ ! "$query_limit" =~ ^[1-9][0-9]*$ ]]; then
    echo 'MAT_QUERY_LIMIT must be a positive integer' >&2
    exit 2
fi
java -Xmx4g -Djava.awt.headless=true --add-exports=java.base/jdk.internal.org.objectweb.asm=ALL-UNNAMED \
     -jar "${launchers[0]}" -consolelog -nosplash -application org.eclipse.mat.api.parse \
     "$1" "-command=${2:-dominator_tree -groupby BY_CLASS}" -format=csv -limit="$query_limit" org.eclipse.mat.api:query
report="logs/$stamp-$(basename "${1%.*}")-dominators.zip"
cp "${1%.*}_Query.zip" "$report"
echo "Query: ${2:-dominator_tree -groupby BY_CLASS}"
echo "Report: $report"
if ! unzip -Z1 "$report" | rg '\.csv$'; then
    echo "MAT produced no CSV result; inspect $report for the query error." >&2
    exit 1
fi
