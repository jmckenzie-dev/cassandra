set -euo pipefail
project_root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$project_root"
mkdir -p logs
exec > >(tee "logs/$(date +%Y%m%d-%H%M%S-%N)-generate-metrics-reference.log") 2>&1
if [[ $# == 1 && ( "$1" == --test || "$1" == --property ) ]]; then
    source venv/bin/activate
    exec python .build/metrics/test_metrics_reference.py "$1"
fi
exec java --class-path lib/snakeyaml-2.4.jar .build/metrics/GenerateMetricsReference.java "$@"
