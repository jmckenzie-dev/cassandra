set -euo pipefail

project_root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$project_root"
mkdir -p logs tmp
launch_log="logs/$(date +%Y%m%d-%H%M%S-%N)-otel-storage.log"
exec > >(tee "$launch_log") 2>&1
echo "# log=$launch_log"

otel_source=ref/opentelemetry-java/sdk/metrics/src/main/java/io/opentelemetry/sdk/metrics/internal/aggregator
classpath="$project_root/build/apache-cassandra-7.0-SNAPSHOT.jar:$project_root/build/lib/jars/*:$project_root/build/test/lib/jars/*"
if [[ ! -f build/apache-cassandra-7.0-SNAPSHOT.jar || ! -f build/lib/jars/jamm-0.4.0.jar ]]; then
    echo 'Run .build/sh/ai-build before this benchmark.' >&2
    exit 1
fi
if [[ ! -f "$otel_source/AdaptingIntegerArray.java" ]]; then
    echo 'This benchmark requires the local ref/opentelemetry-java source checkout.' >&2
    exit 1
fi

classes="$(mktemp -d "$project_root/tmp/otel-storage-classes-XXXXXXXX")"
mapfile -t fixtures < <(rg --files .build/benchmarks/otel-storage -g '*.java')
echo '# Compile the actual storage sources and test-only adapters; no SDK dependency is installed.'
javac -proc:none -cp "$classpath" -d "$classes" \
    src/java/org/apache/cassandra/metrics/AdaptiveCounterArray.java \
    src/java/org/apache/cassandra/metrics/CompactDecayingEstimatedHistogramReservoir.java \
    src/java/org/apache/cassandra/metrics/DecayingEstimatedHistogramReservoir.java \
    "$otel_source/AdaptingIntegerArray.java" \
    "$otel_source/AdaptingCircularBufferCounter.java" \
    "$otel_source/Base2ExponentialHistogramIndexer.java" \
    "${fixtures[@]}"

benchmark_main=org.apache.cassandra.metrics.OtelStorageBenchmark
if [[ "${1:-}" == --bucket-ranges ]]; then
    benchmark_main=io.opentelemetry.sdk.metrics.internal.aggregator.OtelBucketRangeBenchmark
    shift
elif [[ "${1:-}" == --width-over-time ]]; then
    benchmark_main=org.apache.cassandra.metrics.HistogramWidthOverTime
    shift
fi
java -ea -Xms512m -Xmx2g -XX:ActiveProcessorCount=8 -XX:+UseG1GC \
    "-Djava.io.tmpdir=$project_root/tmp" \
    "-javaagent:$project_root/build/lib/jars/jamm-0.4.0.jar" \
    --add-opens java.base/java.lang=ALL-UNNAMED \
    --add-opens java.base/java.util=ALL-UNNAMED \
    --add-opens java.base/java.util.concurrent.atomic=ALL-UNNAMED \
    -cp "$classes:$classpath" "$benchmark_main" "$@"
